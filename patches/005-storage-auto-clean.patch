+#!/usr/bin/env python3
+"""Hands-off storage management: drop full-res video before logs, and video comma already has first.
+
+step() runs inside the stock deleter loop (system/loggerd/deleter.py). Below START_PERCENT free it deletes
+camera files until STOP_PERCENT free is reached:
+  tier 1: video athenad uploaded (UPLOADED_ATTR_NAME, set by mark_uploaded), oldest segment first
+  tier 2: video in segments last written more than MIN_AGE ago, oldest segment first
+  tier 3: video in segments last written more than RECENT_AGE ago, oldest segment first
+Logs, qcamera.ts and segment dirs are never touched. The aim is that the stock deleter (below 10% free, whole
+segments) never has to run in normal use, so logs survive and only older video goes.
+
+Dry run: python -m openpilot.jay.storage --dry-run
+"""
+import argparse
+import json
+import os
+import statistics
+import time
+from dataclasses import dataclass
+
+from openpilot.common.hardware.hw import Paths
+from openpilot.common.params import Params
+from openpilot.common.swaglog import cloudlog
+from openpilot.jay import config
+from openpilot.jay.upload_status import read_upload_status
+from openpilot.system.loggerd.config import SEGMENT_LENGTH
+from openpilot.system.loggerd import xattr_cache
+from openpilot.system.loggerd.deleter import MIN_BYTES, MIN_PERCENT, PRESERVE_ATTR_NAME, get_preserved_segments
+from openpilot.system.loggerd.uploader import listdir_by_creation
+from openpilot.system.loggerd.xattr_cache import setxattr
+
+STATUS_PATH = "/data/jay/storage.json"
+
+START_PERCENT = 15  # start cleaning below this much free space
+STOP_PERCENT = 18   # and stop once this much is free
+MIN_AGE = 7 * 24 * 3600  # tier 2: segments not written for this long
+RECENT_AGE = 24 * 3600   # tier 3: segments not written for this long
+
+VIDEO_NAMES = ("fcamera.hevc", "ecamera.hevc", "dcamera.hevc")
+VIDEO_FILES = VIDEO_NAMES + tuple(n + ".zst" for n in VIDEO_NAMES)
+
+UPLOADED_ATTR_NAME = "user.jay.uploaded"  # not user.upload, which belongs to the stock uploader
+UPLOADED_ATTR_VALUE = b"1"
+
+CHECK_INTERVAL = 30.0   # seconds between steps; the deleter loop runs every 0.1s while it is out of space
+STEP_BUDGET = 5.0       # max seconds spent deleting per step, so the stock deleter keeps running
+USAGE_INTERVAL = 300.0  # seconds between full walks of the log root for video/log bytes
+RATE_SEGMENTS = 30      # recent full segments used to estimate bytes per hour of driving
+FALLBACK_BYTES_PER_HOUR = 10 * 1000 ** 3
+SANE_TIME = 1704067200  # 2024-01-01; the clock starts at 1970 until it syncs, so older mtimes or times are untrusted
+
+
+@dataclass
+class Candidate:
+  tier: int
+  path: str
+  size: int
+  age: float | None  # seconds since the segment was last written, None if the clock can't be trusted
+
+
+def is_segment(d: str) -> bool:
+  route, _, seg = d.rpartition("--")
+  return bool(route) and seg.isdigit()
+
+
+def _norm(path: str) -> str:
+  # athenad uploads "x.zst" by compressing "x" on the fly, so both name the same file
+  return os.path.normpath(path).removesuffix(".zst")
+
+
+def get_pending_uploads() -> set[str]:
+  """Files queued in or currently being uploaded by athenad. Raises if the queue can't be read, so nothing is deleted."""
+  queue = Params().get("AthenadUploadQueue")
+  if isinstance(queue, (bytes, str)):
+    queue = json.loads(queue)
+  paths = [item["path"] for item in queue or [] if isinstance(item, dict) and item.get("path")]
+  status = read_upload_status()
+  if status is not None:
+    paths += [item["path"] for item in status.get("current", []) if item.get("path")]
+  return {_norm(p) for p in paths}
+
+
+def is_onroad() -> bool:
+  # there is no IsOnroad param; the manager sets IsOffroad to "not started". Assume onroad if unsure.
+  try:
+    return not Params().get_bool("IsOffroad")
+  except Exception:
+    return True
+
+
+def get_preserved(dirs: list[str]) -> set[str]:
+  # xattr_cache never expires and loggerd sets user.preserve on bookmark, after we've cached None for the segment.
+  # Drop those entries first, or neither this nor the stock deleter (same process) would ever see new bookmarks.
+  for d in dirs:
+    xattr_cache._cached_attributes.pop((os.path.join(Paths.log_root(), d), PRESERVE_ATTR_NAME), None)
+  return get_preserved_segments(dirs)
+
+
+def is_uploaded(path: str) -> bool:
+  # not xattr_cache.getxattr: its per-process cache would never see marks set later by athenad
+  try:
+    return os.getxattr(path, UPLOADED_ATTR_NAME) == UPLOADED_ATTR_VALUE
+  except (OSError, AttributeError):
+    return False
+
+
+def mark_uploaded(fn: str, status_code: int) -> None:
+  """Called by athenad after an upload; marks the file so tier 1 can delete it."""
+  if status_code not in (200, 201):  # 401/403/412 count as done for athenad but comma didn't store the file
+    return
+  path = fn if os.path.exists(fn) else fn.removesuffix(".zst")
+  setxattr(path, UPLOADED_ATTR_NAME, UPLOADED_ATTR_VALUE)
+
+
+def get_candidates(root: str | None = None, now: float | None = None,
+                   pending: set[str] | None = None, onroad: bool | None = None) -> list[Candidate]:
+  """Video files that may be deleted, in deletion order."""
+  root = root or Paths.log_root()
+  now = time.time() if now is None else now
+  pending = get_pending_uploads() if pending is None else pending
+  onroad = is_onroad() if onroad is None else onroad
+
+  dirs = listdir_by_creation(root)
+  segments = [d for d in dirs if is_segment(d)]
+  preserved = get_preserved(dirs)
+  recording = segments[-1].rpartition("--")[0] if onroad and segments else None
+
+  tiers: dict[int, list[Candidate]] = {1: [], 2: [], 3: []}
+  for d in segments:
+    if d in preserved or d.rpartition("--")[0] == recording:
+      continue
+    try:
+      with os.scandir(os.path.join(root, d)) as it:
+        entries = list(it)
+      if any(e.name.endswith(".lock") for e in entries):
+        continue
+      stats = {e.name: (e.path, e.stat(follow_symlinks=False)) for e in entries if e.is_file(follow_symlinks=False)}
+    except OSError:
+      continue
+
+    newest = max((st.st_mtime for _, st in stats.values()), default=0.0)
+    age = now - newest if newest >= SANE_TIME and now >= SANE_TIME else None
+    for name in VIDEO_FILES:
+      if name not in stats or _norm(stats[name][0]) in pending:
+        continue
+      path, st = stats[name]
+      if is_uploaded(path):
+        tiers[1].append(Candidate(1, path, st.st_size, age))
+      elif age is not None and age > MIN_AGE:
+        tiers[2].append(Candidate(2, path, st.st_size, age))
+      elif age is not None and age > RECENT_AGE:
+        tiers[3].append(Candidate(3, path, st.st_size, age))
+  return tiers[1] + tiers[2] + tiers[3]
+
+
+def disk_usage(root: str) -> tuple[int, int]:
+  """(total, free) bytes of the partition, measured like the stock deleter."""
+  st = os.statvfs(root)
+  return st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
+
+
+def scan_usage(root: str) -> tuple[int, int, float]:
+  """(video bytes, other bytes, bytes per hour of driving) under the log root."""
+  video = other = 0
+  full_segments: list[int] = []
+  for d in listdir_by_creation(root):
+    size = 0
+    names = set()
+    try:
+      with os.scandir(os.path.join(root, d)) as it:
+        for e in it:
+          if not e.is_file(follow_symlinks=False):
+            continue
+          sz = e.stat(follow_symlinks=False).st_size
+          size += sz
+          names.add(e.name.removesuffix(".zst"))
+          if e.name in VIDEO_FILES:
+            video += sz
+          else:
+            other += sz
+    except OSError:
+      continue
+    if is_segment(d) and {"fcamera.hevc", "ecamera.hevc"} <= names:
+      full_segments.append(size)
+
+  recent = full_segments[-RATE_SEGMENTS:]
+  rate = statistics.median(recent) * 3600 / SEGMENT_LENGTH if len(recent) >= 5 else FALLBACK_BYTES_PER_HOUR
+  return video, other, rate
+
+
+def hours_left(total: int, free: int, rate: float) -> float:
+  """Hours of driving before the stock deleter starts removing whole segments."""
+  floor = max(total * MIN_PERCENT / 100, MIN_BYTES)
+  return max(free - floor, 0) / rate if rate > 0 else 0.0
+
+
+class StorageCleaner:
+  def __init__(self, root: str | None = None, status_path: str | None = None):
+    self.root = root or Paths.log_root()
+    self.status_path = status_path or STATUS_PATH
+    self.cleaning = False  # hysteresis state: between START_PERCENT and STOP_PERCENT
+    self._last_step = -CHECK_INTERVAL
+    self._usage: tuple[int, int, float] | None = None
+    self._usage_t = -USAGE_INTERVAL
+
+    prev = self._read_status()
+    self.freed_bytes_total = int(prev.get("freed_bytes_total", 0))
+    self.videos_deleted_total = int(prev.get("videos_deleted_total", 0))
+    self.last_clean_t = prev.get("last_clean_t")
+
+  def _read_status(self) -> dict:
+    try:
+      with open(self.status_path) as f:
+        data = json.load(f)
+      return data if isinstance(data, dict) else {}
+    except (OSError, ValueError):
+      return {}
+
+  def step(self, force: bool = False) -> None:
+    now = time.monotonic()
+    if not force and now - self._last_step < CHECK_INTERVAL:
+      return
+    self._last_step = now
+
+    enabled = bool(config.get("storage_auto_clean"))
+    total, free = disk_usage(self.root)
+    if not enabled or 100 * free / total >= STOP_PERCENT:
+      self.cleaning = False
+    elif 100 * free / total < START_PERCENT:
+      self.cleaning = True
+
+    active = False  # for the UI: cleaning and there is still something to delete
+    if self.cleaning:
+      candidates = get_candidates(self.root)
+      free, done = self._delete(candidates, total, free)
+      active = done < len(candidates)
+      if 100 * free / total >= STOP_PERCENT:
+        self.cleaning = active = False
+
+    self._write_status(total, free, enabled, active)
+
+  def _delete(self, candidates: list[Candidate], total: int, free: int) -> tuple[int, int]:
+    """Deletes candidates in order until STOP_PERCENT is free or STEP_BUDGET runs out. Returns (free, tried)."""
+    target = total * STOP_PERCENT / 100
+    deadline = time.monotonic() + STEP_BUDGET
+    tried = 0
+    for c in candidates:
+      if free >= target or time.monotonic() > deadline:
+        break
+      tried += 1
+      try:
+        os.unlink(c.path)
+      except FileNotFoundError:
+        continue
+      except OSError:
+        cloudlog.exception(f"jay.storage: issue deleting {c.path}")
+        continue
+      age = "?" if c.age is None else f"{c.age / 86400:.1f}d"
+      cloudlog.info(f"jay.storage: deleted {c.path} (tier {c.tier}, {c.size} bytes, age {age})")
+      self.freed_bytes_total += c.size
+      self.videos_deleted_total += 1
+      self.last_clean_t = time.time()
+      if self._usage is not None:
+        video, other, rate = self._usage
+        self._usage = (max(video - c.size, 0), other, rate)
+      free = disk_usage(self.root)[1]
+    return free, tried
+
+  def _write_status(self, total: int, free: int, enabled: bool, cleaning: bool) -> None:
+    if self._usage is None or time.monotonic() - self._usage_t >= USAGE_INTERVAL:
+      self._usage = scan_usage(self.root)
+      self._usage_t = time.monotonic()
+    video, other, rate = self._usage
+
+    status = {
+      "t": time.time(),
+      "total_bytes": total,
+      "free_bytes": free,
+      "video_bytes": video,
+      "log_bytes": other,
+      "auto_clean": enabled,
+      "cleaning": cleaning,
+      "freed_bytes_total": self.freed_bytes_total,
+      "videos_deleted_total": self.videos_deleted_total,
+      "last_clean_t": self.last_clean_t,
+      "hours_left": round(hours_left(total, free, rate), 1),
+    }
+    os.makedirs(os.path.dirname(self.status_path), exist_ok=True)
+    tmp = self.status_path + ".tmp"
+    with open(tmp, "w") as f:
+      json.dump(status, f)
+    os.replace(tmp, self.status_path)
+
+
+_cleaner: StorageCleaner | None = None
+
+
+def step() -> None:
+  """Deleter hook; cheap to call every loop iteration."""
+  global _cleaner
+  if _cleaner is None:
+    _cleaner = StorageCleaner()
+  _cleaner.step()
+
+
+def _gb(n: float) -> str:
+  return f"{n / 1000 ** 3:.2f} GB"
+
+
+def dry_run(root: str | None = None, limit: int = 20) -> None:
+  root = root or Paths.log_root()
+  total, free = disk_usage(root)
+  pct = 100 * free / total
+  enabled = bool(config.get("storage_auto_clean"))
+  print(f"log root: {root}")
+  print(f"free: {_gb(free)} of {_gb(total)} ({pct:.1f}%)  start < {START_PERCENT}%, stop >= {STOP_PERCENT}%, stock deleter < {MIN_PERCENT}%")
+
+  video, other, rate = scan_usage(root)
+  print(f"video: {_gb(video)}, logs and other: {_gb(other)}, rate: {_gb(rate)}/h, hours left: {hours_left(total, free, rate):.1f}")
+
+  would_clean = enabled and pct < START_PERCENT
+  needed = max(total * STOP_PERCENT / 100 - free, 0)
+  print(f"auto clean: {'on' if enabled else 'off'}, onroad: {is_onroad()}, "
+        f"would clean now: {'yes' if would_clean else 'no'} (needs {_gb(needed)} to reach {STOP_PERCENT}%)")
+
+  candidates = get_candidates(root)
+  for tier, label in ((1, "uploaded by athena"), (2, f"older than {MIN_AGE // 3600} h"), (3, f"older than {RECENT_AGE // 3600} h")):
+    cs = [c for c in candidates if c.tier == tier]
+    print(f"tier {tier} ({label}): {len(cs)} files, {_gb(sum(c.size for c in cs))}")
+
+  plan: list[Candidate] = []
+  freed = 0
+  for c in candidates:
+    if freed >= needed:
+      break
+    plan.append(c)
+    freed += c.size
+  by_tier = ", ".join(f"tier {t}: {sum(1 for c in plan if c.tier == t)} files {_gb(sum(c.size for c in plan if c.tier == t))}" for t in (1, 2, 3))
+  print(f"a clean now would delete {len(plan)} files, {_gb(freed)} ({by_tier}) -> {100 * (free + freed) / total:.1f}% free")
+  if needed > freed:
+    print(f"  short by {_gb(needed - freed)}: the rest is left to the stock deleter")
+
+  print(f"first {min(limit, len(plan))}:")
+  for c in plan[:limit]:
+    age = "?" if c.age is None else f"{c.age / 86400:.1f}d"
+    print(f"  tier {c.tier}  {c.size / 1e6:6.1f} MB  {age:>6}  {c.path}")
+  print("dry run: nothing deleted")
+
+
+def main() -> None:
+  parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+  parser.add_argument("--dry-run", action="store_true", help="show what would be deleted, delete nothing")
+  args = parser.parse_args()
+  if not args.dry_run:
+    parser.error("only --dry-run is supported; cleaning runs inside the deleter")
+  dry_run()
+
+
+if __name__ == "__main__":
+  main()
