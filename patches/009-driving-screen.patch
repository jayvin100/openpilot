+++ b/openpilot/jay/onroad.py
@@ -0,0 +1,66 @@
+"""Driving screen additions: minimal mode (no path, lane lines or HUD extras) and a live takeover chip.
+
+Never hides alerts or driver monitoring: those are drawn by AlertRenderer and DriverStateRenderer, which this doesn't touch.
+"""
+import pyray as rl
+
+from openpilot.jay import config
+from openpilot.jay.guard import guarded
+from openpilot.jay.ui.theme import C, T, measure, rounded, text, with_alpha
+from openpilot.system.ui.lib.application import FontWeight
+
+CHIP_MARGIN = 60
+CHIP_TOP = 45
+
+
+@guarded(default=False)
+def minimal_mode() -> bool:
+  return bool(config.get("onroad_minimal"))
+
+
+@guarded(default=False)
+def render_minimal_hud(hud, rect: rl.Rectangle) -> bool:
+  """Called from HudRendererSP._render after speed and set speed are drawn.
+  In minimal mode, draws only the safety-relevant extras and returns True so the rest is skipped."""
+  if not minimal_mode():
+    return False
+  hud.speed_limit_renderer.render(rect)
+  hud.turn_signal_controller.render(rect)   # turn signals and blind spot
+  hud.circular_alerts_renderer.render(rect)  # green light / lead departed
+  return True
+
+
+class TakeoverChip:
+  """Top-right chip: '2 takeovers • 91%' for the current drive."""
+  def __init__(self):
+    self._stats = None
+    self._started_frame = -1
+
+  @guarded()
+  def render(self, rect: rl.Rectangle) -> None:
+    from openpilot.selfdrive.ui.ui_state import ui_state  # imported lazily: ui_state imports UI modules
+    if not config.get("onroad_takeovers"):
+      return
+    if self._stats is None:
+      from openpilot.jay.drives import LiveDriveStats
+      self._stats = LiveDriveStats()
+    if ui_state.started_frame != self._started_frame:
+      self._started_frame = ui_state.started_frame
+      self._stats.reset()
+    self._stats.update(ui_state.sm)
+
+    s = self._stats
+    takeovers = s.disengagements
+    parts = [f"{takeovers} takeover{'' if takeovers == 1 else 's'}"]
+    if s.duration_s > 60 and s.engaged_frac is not None:
+      parts.append(f"{s.engaged_frac * 100:.0f}%")
+    label = " • ".join(parts)
+
+    size = T.SMALL
+    w = measure(label, size, FontWeight.SEMI_BOLD).x + 2 * 30
+    h = 76
+    x = rect.x + rect.width - CHIP_MARGIN - w
+    y = rect.y + CHIP_TOP
+    rounded(rl.Rectangle(x, y, w, h), h / 2, rl.Color(0, 0, 0, 140))
+    color = C.YELLOW if takeovers else with_alpha(C.TEXT, 0.9)
+    text(label, x + 30, y + (h - size) / 2 - 3, size, color, FontWeight.SEMI_BOLD)
