   procs += [NativeProcess("copyparty-sfx", "openpilot/third_party/copyparty", ["./copyparty-sfx.py", *copyparty_args], and_(only_offroad, use_copyparty))]
 
 procs += [PythonProcess("jaydrives", "openpilot.jay.drives", only_offroad)]  # jay
