+"""Skips background processes for features that are switched off.
+
+Read once when the manager starts, so a change takes effect after a reboot.
+"""
+from openpilot.common.params import Params
+
+SUNNYLINK_PROCS = {"manage_sunnylinkd"}  # the others already check SunnylinkEnabled
+
+
+def trim(procs: list) -> list:
+  try:
+    skip = set() if Params().get_bool("SunnylinkEnabled") else SUNNYLINK_PROCS
+  except Exception:
+    return procs
+  return [p for p in procs if p.name not in skip]
