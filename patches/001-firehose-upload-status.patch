+++ b/openpilot/jay/widgets/upload_card.py
@@ -0,0 +1,114 @@
+"""Home screen card with live Firehose / upload status. Replaces the comma prime ad."""
+import pyray as rl
+
+from openpilot.jay.upload_status import UploadStats, describe_upload, format_bytes, shared_upload_stats
+from openpilot.selfdrive.ui.ui_state import ui_state
+from openpilot.system.ui.lib.application import FontWeight, TextAlignment
+from openpilot.system.ui.lib.multilang import tr
+from openpilot.system.ui.widgets import Widget
+from openpilot.system.ui.widgets.label import gui_label
+
+BG_COLOR = rl.Color(51, 51, 51, 255)
+LABEL_COLOR = rl.Color(170, 170, 170, 255)
+GREEN = rl.Color(46, 204, 113, 255)
+ORANGE = rl.Color(243, 156, 18, 255)
+RED = rl.Color(231, 76, 60, 255)
+BAR_BG = rl.Color(85, 85, 85, 255)
+BAR_FG = rl.Color(70, 91, 234, 255)
+MAX_CURRENT_ROWS = 2
+
+
+def network_state() -> tuple[str, rl.Color]:
+  ds = ui_state.sm["deviceState"]
+  network_type = str(ds.networkType)
+  if network_type == "none":
+    return tr("OFFLINE"), RED
+  if ds.networkMetered:
+    return tr("PAUSED: metered"), ORANGE
+  return tr("ACTIVE") + (" • Wi-Fi" if network_type == "wifi" else ""), GREEN
+
+
+class UploadCardWidget(Widget):
+  def __init__(self, stats: UploadStats | None = None):
+    super().__init__()
+    self.stats = stats or shared_upload_stats()
+
+  def _update_state(self):
+    self.stats.update()
+
+  def _render(self, rect: rl.Rectangle):
+    s = self.stats
+    rl.draw_rectangle_rounded(rect, 0.025, 10, BG_COLOR)
+    x, y = rect.x + 70, rect.y + 55
+    w = rect.width - 140
+
+    # Header: title + network state
+    gui_label(rl.Rectangle(x, y, w, 90), tr("Firehose"), 75, font_weight=FontWeight.BOLD)
+    state_text, state_color = network_state()
+    gui_label(rl.Rectangle(x, y, w, 90), state_text, 45, state_color, FontWeight.BOLD, TextAlignment.RIGHT)
+    y += 105
+
+    if s.firehose is None:
+      count_text = tr("Training data count not loaded yet")
+    else:
+      count_text = tr("{} segments in training data").format(s.firehose)
+      if s.firehose_delta > 0:
+        count_text += f"  (+{s.firehose_delta})"
+    gui_label(rl.Rectangle(x, y, w, 65), count_text, 55)
+    y += 110
+
+    # Live uploads
+    gui_label(rl.Rectangle(x, y, w, 50), tr("UPLOADING NOW"), 40, LABEL_COLOR, FontWeight.BOLD)
+    y += 70
+    status = s.status
+    if status is None:
+      gui_label(rl.Rectangle(x, y, w, 60), tr("Waiting for connection to comma..."), 48, LABEL_COLOR)
+      y += 2 * 75
+    else:
+      current = sorted(status["current"], key=lambda c: -c["progress"])
+      for item in current[:MAX_CURRENT_ROWS]:
+        bar_w = 220
+        text_w = w - bar_w - 150
+        gui_label(rl.Rectangle(x, y, text_w, 60), describe_upload(item["path"]), 44)
+        bar = rl.Rectangle(x + w - bar_w - 120, y + 18, bar_w, 24)
+        rl.draw_rectangle_rounded(bar, 1.0, 10, BAR_BG)
+        rl.draw_rectangle_rounded(rl.Rectangle(bar.x, bar.y, max(bar.height, bar.width * item["progress"]), bar.height), 1.0, 10, BAR_FG)
+        gui_label(rl.Rectangle(x, y, w, 60), f"{item['progress'] * 100:.0f}%", 46, alignment=TextAlignment.RIGHT)
+        y += 75
+      if not current:
+        gui_label(rl.Rectangle(x, y, w, 60), tr("Idle. comma pulls segments when it needs them."), 46, LABEL_COLOR)
+        y += 75
+      y += 75 * (MAX_CURRENT_ROWS - max(len(current[:MAX_CURRENT_ROWS]), 1))
+
+      parts = []
+      if current:
+        parts.append(f"{format_bytes(status['speed'])}/s")
+      if len(current) > MAX_CURRENT_ROWS:
+        parts.append(tr("{} more uploading").format(len(current) - MAX_CURRENT_ROWS))
+      parts.append(tr("{} waiting").format(status["queued"]))
+      gui_label(rl.Rectangle(x, y, w, 60), " • ".join(parts), 46, LABEL_COLOR)
+    y += 100
+
+    # Session + device summary
+    label_w = 330
+    if status is not None and not status["success"] and not status["failed"]:
+      session = tr("nothing finished yet")
+    elif status is not None:
+      session = tr("{} uploaded • {}").format(status["success"], format_bytes(status["bytes_done"]))
+      if status["failed"]:
+        session += tr(" • {} failed").format(status["failed"])
+    else:
+      session = "–"
+    gui_label(rl.Rectangle(x, y, label_w, 60), tr("THIS SESSION"), 40, LABEL_COLOR, FontWeight.BOLD)
+    gui_label(rl.Rectangle(x + label_w, y, w - label_w, 60), session, 46)
+    y += 75
+
+    hours = s.segments / 60
+    device = tr("{} drives • {:.0f} h • {}% full").format(s.drives, hours, s.disk_used_pct)
+    gui_label(rl.Rectangle(x, y, label_w, 60), tr("ON DEVICE"), 40, LABEL_COLOR, FontWeight.BOLD)
+    gui_label(rl.Rectangle(x + label_w, y, w - label_w, 60), device, 46)
+    y += 75
+
+    logs = tr("{} of {} uploaded").format(s.qlogs_uploaded, s.segments)
+    gui_label(rl.Rectangle(x, y, label_w, 60), tr("DRIVE LOGS"), 40, LABEL_COLOR, FontWeight.BOLD)
+    gui_label(rl.Rectangle(x + label_w, y, w - label_w, 60), logs, 46)
