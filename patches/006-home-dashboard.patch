+"""Home screen dashboard: a "Ready" card (time, software, last drive), Firehose uploads and storage. Replaces the prime
+ad and the setup / Firehose prompt. Also the sidebar tweaks: real temperature, only the boxes that need attention."""
+import datetime as dt
+import json
+import os
+import shutil
+import time
+from zoneinfo import ZoneInfo
+
+import pyray as rl
+
+from openpilot.common.hardware.hw import Paths
+from openpilot.common.params import Params
+from openpilot.jay import config
+from openpilot.jay.guard import guarded
+from openpilot.jay.ui.theme import C, S, T, bar, card, dot, label, pill, text, text_right, hline
+from openpilot.jay.upload_status import describe_upload, format_bytes, format_time_left, shared_upload_stats, time_left
+from openpilot.system.ui.lib.application import FontWeight
+from openpilot.system.ui.widgets import Widget
+
+DRIVES_PATH = "/data/jay/drives.json"
+STORAGE_PATH = "/data/jay/storage.json"
+GAP = S.MD
+LEFT_WIDTH = 860
+PARAMS_INTERVAL = 2.0  # seconds between reads of the updater params
+
+
+class JsonFile:
+  """Re-reads a JSON file when it changes, checking at most every `interval` seconds."""
+  def __init__(self, path: str, interval: float = 5.0):
+    self.path = path
+    self.interval = interval
+    self.data = None
+    self._mtime = -1.0
+    self._checked = 0.0
+
+  def get(self):
+    now = time.monotonic()
+    if now - self._checked >= self.interval:
+      self._checked = now
+      try:
+        mtime = os.path.getmtime(self.path)
+        if mtime != self._mtime:
+          with open(self.path) as f:
+            self.data = json.load(f)
+          self._mtime = mtime
+      except (OSError, ValueError):
+        pass
+    return self.data
+
+
+def local_time(ts: float) -> dt.datetime:
+  try:
+    tz = ZoneInfo(str(config.get("timezone")))
+  except Exception:
+    tz = None
+  return dt.datetime.fromtimestamp(ts, tz)
+
+
+def format_day(ts: float | None) -> str:
+  if not ts:
+    return ""
+  t = local_time(ts)
+  today = local_time(time.time()).date()
+  clock = t.strftime("%I:%M %p").lstrip("0").lower()
+  if t.date() == today:
+    return f"Today {clock}"
+  if t.date() == today - dt.timedelta(days=1):
+    return f"Yesterday {clock}"
+  return t.strftime("%a %d %b").replace(" 0", " ") + f" {clock}"
+
+
+def time_ago(when: dt.datetime | None) -> str:
+  """Naive UTC datetime (as the updater stores it) -> '12 min ago'. Empty if unknown or the clock isn't set yet."""
+  if not isinstance(when, dt.datetime):
+    return ""
+  now = dt.datetime.now(dt.UTC).replace(tzinfo=None)
+  if now.year < 2024:
+    return ""
+  s = max((now - when.replace(tzinfo=None)).total_seconds(), 0)
+  if s < 90:
+    return "just now"
+  if s < 3600:
+    return f"{round(s / 60)} min ago"
+  if s < 48 * 3600:
+    return f"{round(s / 3600)} h ago"
+  return f"{round(s / 86400)} days ago"
+
+
+def short_version(params, key: str = "UpdaterCurrentDescription") -> str:
+  """'2026.10.23-4973 / dev-jay / 8777fb0 / Oct 23' -> 'dev-jay • Oct 23'"""
+  parts = [p.strip() for p in (params.get(key) or "").split("/")]
+  if len(parts) >= 4:
+    return f"{parts[1]} • {parts[3]}"
+  return " • ".join(p for p in parts if p)
+
+
+def software_status(params) -> tuple[str, str, rl.Color]:
+  """Updater params -> (headline, detail, color), in the order the stock software panel checks them."""
+  current = short_version(params).replace(" • ", " ")
+  checked = time_ago(params.get("LastUpdateTime"))
+  if params.get_bool("DisableUpdates"):
+    return "Updates off", current, C.TEXT_DIM
+  state = params.get("UpdaterState") or "idle"
+  if state == "downloading...":
+    return "Downloading update", "Installs on the next reboot once it's ready", C.BLUE
+  if state == "finalizing update...":
+    return "Preparing update", "Almost done downloading", C.BLUE
+  if params.get_bool("UpdateAvailable"):
+    new = short_version(params, "UpdaterNewDescription").replace(" • ", " ")
+    return "Update ready", " • ".join(p for p in (new, "installs on next reboot") if p), C.BLUE
+  if state == "checking...":
+    return "Checking for updates", current, C.TEXT_DIM
+  if (params.get("UpdateFailedCount") or 0) > 0:
+    detail = f"last good check {checked}" if checked else "will retry"
+    return "Update failed", f"{current} • {detail}" if current else detail, C.YELLOW
+  if params.get_bool("UpdaterFetchAvailable"):
+    return "Update available", "Downloads on the next check over Wi-Fi", C.BLUE
+  return "Up to date", " • ".join(p for p in (current, f"checked {checked}" if checked else "") if p), C.GREEN
+
+
+class JayHome(Widget):
+  def __init__(self):
+    super().__init__()
+    self._params = Params()
+    self._uploads = shared_upload_stats()
+    self._drives = JsonFile(DRIVES_PATH)
+    self._storage = JsonFile(STORAGE_PATH)
+    self._disk = (0, 0)
+    self._disk_checked = 0.0
+    self._software: tuple[str, str, rl.Color] | None = None
+    self._params_checked = 0.0
+
+  def _update_state(self):
+    self._uploads.update()
+    now = time.monotonic()
+    if now - self._disk_checked > 10:
+      self._disk_checked = now
+      try:
+        du = shutil.disk_usage(Paths.log_root())
+        self._disk = (du.total, du.free)
+      except OSError:
+        pass
+    if now - self._params_checked > PARAMS_INTERVAL:
+      self._params_checked = now
+      try:
+        self._software = software_status(self._params)
+      except Exception:
+        self._software = None
+
+  def _render(self, rect: rl.Rectangle):
+    left = rl.Rectangle(rect.x, rect.y, LEFT_WIDTH, rect.height)
+    right_w = rect.width - LEFT_WIDTH - GAP
+    half = (rect.height - GAP) / 2
+    self._draw_ready(left)
+    self._draw_uploads(rl.Rectangle(rect.x + LEFT_WIDTH + GAP, rect.y, right_w, half))
+    self._draw_storage(rl.Rectangle(rect.x + LEFT_WIDTH + GAP, rect.y + half + GAP, right_w, half))
+
+  # Ready: time, software, last drive
+
+  @guarded()
+  def _draw_ready(self, rect: rl.Rectangle):
+    r = card(rect)
+    label("Ready", r.x, r.y)
+
+    now = local_time(time.time())
+    y = r.y + 60
+    w = text(now.strftime("%I:%M").lstrip("0"), r.x, y, T.HERO, weight=FontWeight.BOLD)
+    text(now.strftime("%p").lower(), r.x + w + S.SM, y + T.HERO - T.H2 - 22, T.H2, C.TEXT_DIM, FontWeight.SEMI_BOLD)
+    text(now.strftime("%A, %d %B").replace(" 0", " "), r.x, y + T.HERO + 10, T.BODY, C.TEXT_DIM)
+
+    y = r.y + 360
+    hline(r.x, y, r.width)
+    y += S.LG
+    label("Software", r.x, y)
+    if self._software:
+      headline, detail, color = self._software
+      y += 60
+      dot(r.x + 12, y + T.H2 / 2 + 4, 12, color)
+      text(headline, r.x + 44, y, T.H2, weight=FontWeight.SEMI_BOLD, max_width=r.width - 44)
+      text(detail, r.x + 44, y + T.H2 + 18, T.SMALL, C.TEXT_DIM, max_width=r.width - 44)
+
+    y = r.y + r.height - 75
+    hline(r.x, y - S.LG, r.width)
+    text(self._last_drive_line(), r.x, y, T.BODY, C.TEXT_DIM, max_width=r.width)
+
+  def _last_drive_line(self) -> str:
+    data = self._drives.get() or {}
+    drives = [d for d in data.get("drives", []) if d.get("moving_s", 0) > 60]
+    if not drives:
+      return "No drives yet"
+    d = drives[-1]
+    day = format_day(d.get("start") or d.get("summarized_at"))
+    if day.startswith(("Today", "Yesterday")):
+      day = day[0].lower() + day[1:]
+    km = d.get("distance_m", 0) / 1000
+    return " • ".join(p for p in (f"Last drive {day}".strip(), f"{km:.1f} km") if p)
+
+  # Uploads
+
+  def _network_pill(self) -> tuple[str, rl.Color]:
+    from openpilot.selfdrive.ui.ui_state import ui_state  # imported lazily: ui_state is heavy and imports UI modules
+    ds = ui_state.sm["deviceState"]
+    network = str(ds.networkType)
+    if network == "none":
+      return "Offline", C.RED
+    if ds.networkMetered:
+      return "Paused on mobile data", C.YELLOW
+    if self._uploads.status is None:
+      return "Connecting", C.TEXT_DIM
+    return "Wi-Fi" if network == "wifi" else "Online", C.GREEN
+
+  @guarded()
+  def _draw_uploads(self, rect: rl.Rectangle):
+    r = card(rect)
+    s = self._uploads
+    label("Firehose uploads", r.x, r.y)
+    pill_text, pill_color = self._network_pill()
+    pill(pill_text, r.x + r.width, r.y - 14, pill_color, right_align=True)
+
+    y = r.y + 60
+    count = "-" if s.firehose is None else str(s.firehose)
+    w = text(count, r.x, y, T.DISPLAY, weight=FontWeight.BOLD)
+    text("segments in", r.x + w + S.MD, y + 14, T.SMALL, C.TEXT_DIM)
+    text("training data", r.x + w + S.MD, y + 58, T.SMALL, C.TEXT_DIM)
+    if s.firehose_delta > 0:
+      text_right(f"+{s.firehose_delta} today", r.x + r.width, y + 36, T.BODY, C.GREEN, FontWeight.SEMI_BOLD)
+
+    y = r.y + r.height - 125
+    status = s.status
+    if status is None:
+      text("Waiting for comma to connect", r.x, y, T.BODY, C.TEXT_DIM)
+      return
+    current = sorted(status["current"], key=lambda c: -c["progress"])
+    if current:
+      top = current[0]
+      p = f"{top['progress'] * 100:.0f}%"
+      pw = text_right(p, r.x + r.width, y, T.BODY, C.TEXT_DIM)
+      more = f" (+{len(current) - 1})" if len(current) > 1 else ""
+      text(describe_upload(top["path"]) + more, r.x, y, T.BODY, max_width=r.width - pw - S.MD)
+      bar(rl.Rectangle(r.x, y + 66, r.width, 12), top["progress"], C.BLUE)
+      speed = status.get("avg_speed") or status["speed"]
+      parts = [f"{format_bytes(speed)}/s"]
+      if status["queued"]:
+        parts.append(f"{status['queued']} waiting")
+      left = time_left(status)
+      if left is not None:
+        parts.append(format_time_left(left))
+      text(" • ".join(parts), r.x, y + 96, T.SMALL, C.TEXT_DIM, max_width=r.width)
+    else:
+      text("Idle", r.x, y, T.BODY)
+      queued = status["queued"]
+      sub = f"{queued} waiting" if queued else "comma pulls segments when it needs them"
+      text(sub, r.x, y + 60, T.SMALL, C.TEXT_DIM, max_width=r.width)
+
+  # Storage
+
+  @guarded()
+  def _draw_storage(self, rect: rl.Rectangle):
+    r = card(rect)
+    st = self._storage.get() or {}
+    total = st.get("total_bytes") or self._disk[0]
+    free = st.get("free_bytes", self._disk[1]) if st and time.time() - st.get("t", 0) < 600 else self._disk[1]
+    label("Storage", r.x, r.y)
+
+    auto = config.get("storage_auto_clean")
+    if not auto:
+      pill("Auto-clean off", r.x + r.width, r.y - 14, C.TEXT_DIM, right_align=True)
+    elif st.get("cleaning"):
+      pill("Cleaning", r.x + r.width, r.y - 14, C.BLUE, right_align=True)
+    else:
+      pill("Auto-clean on", r.x + r.width, r.y - 14, C.GREEN, right_align=True)
+
+    y = r.y + 60
+    w = text(f"{free / 1e9:.0f} GB", r.x, y, T.DISPLAY, weight=FontWeight.BOLD)
+    text("free of", r.x + w + S.MD, y + 14, T.SMALL, C.TEXT_DIM)
+    text(f"{total / 1e9:.0f} GB" if total else "", r.x + w + S.MD, y + 58, T.SMALL, C.TEXT_DIM)
+
+    # Legend for the bar, right-aligned next to the free space
+    if st.get("video_bytes"):
+      for i, (name, size, color) in enumerate((("Video", st["video_bytes"], C.BLUE), ("Logs", st.get("log_bytes", 0), C.ACCENT))):
+        ly = y + 14 + i * 44
+        lw = text_right(f"{name} {format_bytes(size)}", r.x + r.width, ly, T.SMALL, C.TEXT_DIM)
+        dot(r.x + r.width - lw - 22, ly + T.SMALL / 2 + 2, 9, color)
+
+    # Usage bar: video, logs, everything else, free
+    y = r.y + r.height - 125
+    if total:
+      video, logs = st.get("video_bytes", 0), st.get("log_bytes", 0)
+      other = max(total - free - video - logs, 0)
+      x = r.x
+      rounded_track = rl.Rectangle(r.x, y, r.width, 22)
+      bar(rounded_track, 0)
+      for size, color in ((video, C.BLUE), (logs, C.ACCENT), (other, C.TEXT_FAINT)):
+        seg_w = r.width * size / total
+        if seg_w >= 1:
+          rl.draw_rectangle_rec(rl.Rectangle(x, y, seg_w, 22), color)
+          x += seg_w
+      # round the bar's ends over the square segments
+      rl.draw_rectangle_rounded_lines_ex(rl.Rectangle(r.x - 6, y - 6, r.width + 12, 34), 1.0, 16, 8, C.CARD)
+
+    hours = st.get("hours_left")
+    if auto and st.get("cleaning"):
+      line = "Clearing old video to make room"
+    elif auto and st.get("freed_bytes_total"):
+      line = f"Old video clears itself • {format_bytes(st['freed_bytes_total'])} freed so far"
+    elif auto:
+      line = "Old video clears itself when space runs low"
+    elif hours is not None:
+      line = f"About {hours:.0f} h of driving before old drives are removed" if hours >= 1 else "Full: oldest drives are being removed"
+    else:
+      line = ""
+    text(line, r.x, y + 50, T.SMALL, C.TEXT_DIM, max_width=r.width)
+
+
+
+# Sidebar
+
+THERMAL_COLORS = {"ok": "GOOD", "overheated": "WARNING", "critical": "DANGER"}
+
+
+@guarded()
+def sidebar_metrics(metrics: list, colors) -> list | None:
+  """Shows the real temperature in the TEMP box and drops the VEHICLE and CONNECT boxes while they're fine.
+  Takes and returns the sidebar's (MetricData, y offset) list, packing the kept boxes into the top slots.
+  None (on error) means keep the stock boxes."""
+  from openpilot.selfdrive.ui.ui_state import ui_state  # imported lazily: ui_state is heavy and imports UI modules
+  ds = ui_state.sm["deviceState"]
+  shown = []
+  for m, _ in metrics:
+    if m.label == "TEMP":
+      color = getattr(colors, THERMAL_COLORS.get(str(ds.thermalStatus), "DANGER"))
+      m.update("TEMP", f"{round(ds.maxTempC)}°C" if ds.maxTempC > 0 else m.value, color)
+    elif m.label in ("VEHICLE", "CONNECT") and m.value == "ONLINE":
+      continue
+    shown.append(m)
+  return list(zip(shown, (y for _, y in metrics), strict=False))
+
+
+@guarded(default=True)
+def show_home_button() -> bool:
+  """The comma button at the bottom of the sidebar bookmarks the moment while driving and does nothing offroad."""
+  from openpilot.selfdrive.ui.ui_state import ui_state
+  return bool(ui_state.started)
